APP_NAME=vehicle-data-api
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8087
APP_VERSION=dev
APP_LOCALE=ro
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
# Docker dev: CLI runs as root, the web server as nobody; 0666 keeps a root-created log writable. Use 0664 on hosting.
LOG_FILE_PERMISSION=0666

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=vehicle_data
DB_USERNAME=vehicle_data
DB_PASSWORD=vehicle_data

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=array

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Compose project name: containers, networks and volumes are addressed by it.
# A second checkout of this repository must set a different value, or its
# `docker compose` commands recreate the first checkout's containers in place.
COMPOSE_PROJECT_NAME=vehicle-data-api

# Docker host ports (compose.yaml reads these)
VD_HTTP_PORT=8087
VD_DB_PORT=3314
VD_MAILPIT_SMTP_PORT=1032
VD_MAILPIT_UI_PORT=8032
# MariaDB image tag for the dev stack: 10.5 is the shared-hosting target, 10.11 the supported baseline;
# CI runs 10.5 and 10.11 as required legs. After changing the tag, `docker compose down -v` (this deletes
# the dev database volume), `docker compose up -d`, and re-seed with `php artisan migrate --seed --force`.
VD_MARIADB_TAG=10.5

# Core package
CORE_TRUSTED_PROXIES=
CORE_MAX_BODY_BYTES=65536
CORE_IMPORT_REJECT_SHARE=0.05
# 1.0 by design for the wmi source (vPIC's 6-character WMIs are always rejected), so a wmi run never
# aborts on its reject share: check its reject count instead, see docs/known-limitations.md (R11).
CORE_IMPORT_REJECT_SHARE_WMI=1.0
CORE_EEA_COUNTRY=RO
# PUBLIC: rendered into /docs for anonymous visitors, so anyone can see and use it. An origin
# allow-list only stops browser JavaScript from a different origin from using the key — it is
# not a security boundary against a non-browser caller. Use only a catalogue:read-only key with
# a low rate and quota (vehicle:client create --scopes=catalogue:read --rate=5 --quota=200).
CORE_DOCS_TRY_IT_KEY=
CORE_AUTH_FAIL_PER_MINUTE=30
CORE_REQUEST_RETENTION_DAYS=90

# Observability (optional)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
